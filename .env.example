BOOKSTACK_URL=https://docs.example.com
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=
# Secrets can come from files instead (Docker secrets); set either the value or the _FILE form.
# BOOKSTACK_TOKEN_ID_FILE=/run/secrets/bookstack_token_id
# BOOKSTACK_TOKEN_SECRET_FILE=/run/secrets/bookstack_token_secret
BOOKSTACK_MCP_TOOLSETS=core
BOOKSTACK_MCP_READ_ONLY=false
# BOOKSTACK_MCP_ALLOW_DELETE=false
# BOOKSTACK_MCP_REQUESTS_PER_MINUTE=150
# BOOKSTACK_MCP_TIMEOUT_SECONDS=30
# BOOKSTACK_MCP_MAX_READ_CHARS=20000
# BOOKSTACK_MCP_VERIFY_TLS=true
# BOOKSTACK_MCP_CA_BUNDLE=/path/to/ca.pem
# BOOKSTACK_MCP_LOG_LEVEL=INFO
